import java.util.Scanner;

public class Main {
  public static void main(String[] args) {

int numero = 1;

    while(numero != 0){
      Scanner sc = new Scanner(System.in);
        System.out.println("Escolha a forma que você quer saber a área");
        System.out.println("\n");
        System.out.println("1-Quadrado\n 2-circulo\n 3-Triangulo\n 4-Fim ");
           numero = sc.nextInt();

        if(numero==1){
          System.out.println("Digite o lado do quadrado");
          int lado = sc.nextInt();
          int quadrado = lado*lado; 
          System.out.println("A área do quadrado é" + quadrado);    
        }
        else if(numero==2){
          System.out.println("Digite o raio do circulo");
          int raio = sc.nextInt();
          double circulo = 3.14*(raio*raio); 
          System.out.println("A área do circulo é" + circulo);
        }
         else if (numero==3){
           System.out.println("Digite a base do triangulo");
           int basetri = sc.nextInt();
           System.out.println("digite a altura do triangulo");
           int alturatri = sc.nextInt();
           int triangulo = (basetri*alturatri)/2;
           System.out.println("A área do triangulo é" + triangulo);
         }
          else if (numero==4){
            System.out.println(" >>> FIM DO PROGRAMA <<<");
          }
          else {
            System.out.println("Opção inválida");
      } 
    }
 }
}
